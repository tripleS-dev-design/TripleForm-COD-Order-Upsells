{% comment %}
Tripleform COD – App block (product template)

✅ CONFORME SHOPIFY – Aucune donnée personnelle collectée
✅ Champs autorisés : quantity, pincode, pincode2, pincode3, notes
✅ Carrier Service pour les frais de livraison (pas de calcul front-end)
✅ reCAPTCHA v2 uniquement via data-*
✅ Popup "Thank you" désactivée
{% endcomment %}

{%- assign tf_prod_val = product.metafields.tripleform_cod.settings.value -%}
{%- assign tf_shop_val = shop.metafields.tripleform_cod.settings.value -%}

{%- comment -%} ✅ reCAPTCHA config (PUBLIC) {%- endcomment -%}
{%- assign tf_antibot_mf = shop.metafields.tripleform_cod.antibot -%}
{%- assign tf_recaptcha_site_key = '' -%}
{%- assign tf_recaptcha_enabled = false -%}

{%- if tf_antibot_mf != blank and tf_antibot_mf.value != blank and tf_antibot_mf.value.recaptcha != blank -%}
  {%- assign tf_recaptcha_site_key = tf_antibot_mf.value.recaptcha.siteKey | default: '' -%}
  {%- if tf_antibot_mf.value.recaptcha.enabled == true and tf_recaptcha_site_key != blank -%}
    {%- assign tf_recaptcha_enabled = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ✅ UI toggles from GEO config (product > shop fallback) – seulement coupon et variantes {%- endcomment -%}
{%- assign tf_geo_prod_val = product.metafields.tripleform_cod.geo.value -%}
{%- assign tf_geo_shop_val = shop.metafields.tripleform_cod.geo.value -%}

{%- assign tf_ui_coupon = false -%}
{%- assign tf_ui_variants = false -%}

{%- assign tf_geo_json = blank -%}
{%- if tf_geo_prod_val and tf_geo_prod_val != blank -%}
  {%- assign tf_geo_json = tf_geo_prod_val -%}
{%- elsif tf_geo_shop_val and tf_geo_shop_val != blank -%}
  {%- assign tf_geo_json = tf_geo_shop_val -%}
{%- endif -%}

{%- if tf_geo_json and tf_geo_json != blank -%}
  {%- assign tf_geo = tf_geo_json -%}
  {%- if tf_geo.ui != blank -%}
    {%- if tf_geo.ui.enableCouponField == true -%}{%- assign tf_ui_coupon = true -%}{%- endif -%}
    {%- if tf_geo.ui.enableVariantSelector == true -%}{%- assign tf_ui_variants = true -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ✅ Theme Editor layout defaults {%- endcomment -%}
{%- assign tf_summary_position = section.settings.summary_position | default: 'top' -%}
{%- assign tf_summary_order = section.settings.summary_order | default: 3 -%}
{%- assign tf_offers_position = section.settings.offers_position | default: 'top' -%}
{%- assign tf_offers_order = section.settings.offers_order | default: 1 -%}
{%- assign tf_upsells_position = section.settings.upsells_position | default: 'top' -%}
{%- assign tf_upsells_order = section.settings.upsells_order | default: 2 -%}

{%- comment -%} ✅ Settings JSON (product > shop > default) – SANS CHAMPS PERSONNELS – POPUP DÉSACTIVÉE {%- endcomment -%}
{%- if tf_prod_val and tf_prod_val != blank -%}
  {%- assign tf_json = tf_prod_val -%}
{%- elsif tf_shop_val and tf_shop_val != blank -%}
  {%- assign tf_json = tf_shop_val -%}
{%- else -%}
  {%- capture tf_json -%}
  {
    "meta": {
      "version": 5,
      "preset": "CleanWhite",
      "uiPreset": "{{ section.settings.ui_preset | default: 'A' }}",
      "fieldsOrder": ["quantity","pincode","pincode2","pincode3","notes"]
    },
    "form": {
      "style": "inline",
      "title": "Order form",
      "subtitle": "Enter quantity and delivery details",
      "buttonText": "Order now",
      "successText": "Thanks! We'll contact you",
      "buttonIcon": "CartIcon"
    },
    "thankyou": {
      "enabled": false
    },
    "design": {
      "bg": "#FFFFFF",
      "text": "#0F172A",
      "border": "#E5E7EB",
      "radius": 12,
      "padding": 16,
      "inputBg": "#FFFFFF",
      "inputBorder": "#E5E7EB",
      "placeholder": "#94A3B8",
      "btnBg": "#111827",
      "btnText": "#FFFFFF",
      "btnBorder": "#111827",
      "btnHeight": 46,
      "btnRadius": 10,
      "shadow": true,
      "glow": false,
      "glowPx": 18,
      "cartBg": "#FFFFFF",
      "cartBorder": "#E5E7EB",
      "cartRowBg": "#FFFFFF",
      "cartRowBorder": "#E5E7EB",
      "cartTitleColor": "#0F172A",
      "cartTextColor": "#0F172A",
      "direction": "ltr",
      "fontSize": 14,
      "titleAlign": "left",
      "fieldAlign": "left"
    },
    "behavior": {
      "requireGDPR": false,
      "gdprLabel": "I accept the privacy policy",
      "whatsappOptIn": false,
      "whatsappLabel": "Receive confirmation on WhatsApp",
      "openDelayMs": 0,
      "closeOnOutside": true,
      "effect": "none",
      "buttonMotion": "none",
      "stickyType": "none",
      "stickyLabel": "Order now",
      "stickyIcon": "CartIcon",
      "drawerDirection": "right",
      "drawerSize": "md",
      "overlayColor": "#020617",
      "overlayOpacity": 70,
      "country": "{{ shop.country_code | default: 'MA' }}",
      "codCountry": "{{ shop.country_code | default: 'MA' }}"
    },
    "fields": {
      "quantity": { "on": true, "required": true, "type": "number", "label": "Quantity", "ph": "1", "min": 1, "max": 10, "icon": "HashtagIcon" },
      "pincode": { "on": true, "required": false, "type": "text", "label": "Pincode / Postal code", "ph": "e.g., 75001", "icon": "MapPinIcon" },
      "pincode2": { "on": false, "required": false, "type": "text", "label": "Additional pincode", "ph": "(optional)", "icon": "MapPinIcon" },
      "pincode3": { "on": false, "required": false, "type": "text", "label": "Extra pincode", "ph": "(optional)", "icon": "MapPinIcon" },
      "notes": { "on": false, "required": false, "type": "textarea", "label": "Order notes", "ph": "(optional)", "icon": "NoteIcon" }
    },
    "cartTitles": {
      "top": "Order summary",
      "price": "Product price",
      "shipping": "Shipping price",
      "total": "Total",
      "shippingToCalculate": "Calculated at checkout",
      "cartIcon": "CartIcon"
    },
    "uiTitles": {
      "applyCoupon": "Apply",
      "orderNow": "Order now",
      "totalSuffix": "Total:"
    },
    "ui": {
      "enableCouponField": {{ tf_ui_coupon | json }},
      "enableVariantSelector": {{ tf_ui_variants | json }}
    }
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} ✅ OFFERS / UPSELL (product > shop > default) {%- endcomment -%}
{%- assign tf_offers_prod_val = product.metafields.tripleform_cod.offers.value -%}
{%- assign tf_offers_shop_val = shop.metafields.tripleform_cod.offers.value -%}

{%- if tf_offers_prod_val and tf_offers_prod_val != blank -%}
  {%- assign tf_offers_json = tf_offers_prod_val -%}
{%- elsif tf_offers_shop_val and tf_offers_shop_val != blank -%}
  {%- assign tf_offers_json = tf_offers_shop_val -%}
{%- else -%}
  {%- capture tf_offers_json -%}
  {
    "meta": { "version": 10 },
    "global": {
      "enabled": true,
      "currency": "{{ shop.currency | default: 'MAD' }}",
      "rounding": "none",
      "colorPalette": "blue-gradient"
    },
    "offers": [],
    "upsells": [],
    "display": {
      "showOrderSummary": true,
      "showOffersSection": true,
      "showTimerInPreview": true,
      "showActivationButtons": true
    }
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} ✅ Correction des éventuels caractères Ruby hash {%- endcomment -%}
{%- assign tf_settings_fixed = tf_json | replace: '=&gt;', ':' | replace: '"nil"', 'null' | replace: 'nil', 'null' -%}
{%- assign tf_offers_fixed = tf_offers_json | replace: '=&gt;', ':' | replace: '"nil"', 'null' | replace: 'nil', 'null' -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div
  id="tripleform-cod-{{ section.id }}"
  class="tripleform-cod"
  data-section-id="{{ section.id }}"
  data-ui-preset="{{ section.settings.ui_preset | default: 'A' }}"
  data-settings="{{ tf_settings_fixed | escape }}"
  data-offers="{{ tf_offers_fixed | escape }}"
  data-product-id='{{ product.id }}'
  data-variant-id='{{ current_variant.id }}'
  data-currency='{{ cart.currency.iso_code | default: shop.currency }}'
  data-locale='{{ request.locale.iso_code }}'

  data-summary-position="{{ tf_summary_position }}"
  data-summary-order="{{ tf_summary_order }}"
  data-offers-position="{{ tf_offers_position }}"
  data-offers-order="{{ tf_offers_order }}"
  data-upsells-position="{{ tf_upsells_position }}"
  data-upsells-order="{{ tf_upsells_order }}"

  data-recaptcha-enabled="{% if tf_recaptcha_enabled %}true{% else %}false{% endif %}"
  data-recaptcha-version="v2"
  data-recaptcha-site-key="{{ tf_recaptcha_site_key | escape }}"
  data-recaptcha-v2-size="normal"
  data-recaptcha-v2-theme="light"
  data-recaptcha-v2-container="#tf-recaptcha-v2-{{ section.id }}"

  {%- comment -%} ✅ GEO désactivé pour le front – le Carrier Service gère les frais {%- endcomment -%}
  data-geo-enabled="false"
  data-geo-country="{{ shop.country_code | default: 'MA' }}"
  data-geo-endpoint=""

  data-ui-coupon="{% if tf_ui_coupon %}true{% else %}false{% endif %}"
  data-ui-variants="{% if tf_ui_variants %}true{% else %}false{% endif %}"
  data-cart-mode="false"
>
  <noscript>Enable JavaScript to use the COD form.</noscript>

  <div style="font:14px/1.4 system-ui, sans-serif; color:#6b7280">
    Loading COD form…
  </div>

  {%- if tf_recaptcha_enabled -%}
    <div
      id="tf-recaptcha-v2-{{ section.id }}"
      class="tf-recaptcha-v2"
      style="margin-top:12px"
      aria-label="reCAPTCHA"
    ></div>
  {%- endif -%}
</div>

<script type="application/json" id="tf-product-json-{{ section.id }}">
  {{ product | json }}
</script>

<script>
  (function () {
    function runBoot() {
      const el = document.getElementById('tripleform-cod-{{ section.id }}');
      if (!el || !window.TripleformCOD || typeof window.TripleformCOD.boot !== 'function') return;

      if (el.getAttribute('data-tf-booted') === '1' && el.querySelector('.tf-shell')) return;

      try {
        window.TripleformCOD.boot(el);
      } catch (e) {
        console.warn('[Tripleform COD] boot error:', e);
        el.removeAttribute('data-tf-booted');
      }
    }

    function schedule() {
      runBoot();
      setTimeout(runBoot, 150);
      setTimeout(runBoot, 800);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule);
    else schedule();

    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:select', schedule);
    document.addEventListener('shopify:block:select', schedule);
  })();
</script>

{% schema %}
{
  "name": "Tripleform COD form",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "tripleform-cod.css",
  "javascript": "tripleform.js",
  "settings": [
    {
      "type": "select",
      "id": "ui_preset",
      "label": "UI preset",
      "default": "A",
      "options": [
        { "value": "A", "label": "Preset A — Clean cards" },
        { "value": "B", "label": "Preset B — Underline + sticky bar" },
        { "value": "C", "label": "Preset C — Glass + offers inside" }
      ]
    },
    {
      "type": "header",
      "content": "Blocks layout (Offers / Upsells / Summary)"
    },
    {
      "type": "select",
      "id": "offers_position",
      "label": "Offers position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "offers_order", "label": "Offers order", "min": 1, "max": 3, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "upsells_position",
      "label": "Upsells position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "upsells_order", "label": "Upsells order", "min": 1, "max": 3, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "summary_position",
      "label": "Order summary position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "summary_order", "label": "Order summary order", "min": 1, "max": 3, "step": 1, "default": 3 }
  ]
}
{% endschema %}
