{% comment %}
Tripleform COD – Cart section

✅ OLD LOGIC for data-settings / data-offers (no double JSON encoding)
✅ Adds 3 options from GEO (shop level):
- ui.enableCouponField
- ui.enableVariantSelector
✅ Cart mode true
✅ Layout fallback
✅ reCAPTCHA v2 ONLY via data-*
{% endcomment %}

{%- assign tf_shop_val = shop.metafields.tripleform_cod.settings.value -%}

{%- comment -%} ✅ reCAPTCHA config {%- endcomment -%}
{%- assign tf_antibot_mf = shop.metafields.tripleform_cod.antibot -%}
{%- assign tf_recaptcha_site_key = '' -%}
{%- assign tf_recaptcha_enabled = false -%}

{%- if tf_antibot_mf != blank and tf_antibot_mf.value != blank and tf_antibot_mf.value.recaptcha != blank -%}
  {%- assign tf_recaptcha_site_key = tf_antibot_mf.value.recaptcha.siteKey | default: '' -%}
  {%- if tf_antibot_mf.value.recaptcha.enabled == true and tf_recaptcha_site_key != blank -%}
    {%- assign tf_recaptcha_enabled = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ✅ UI toggles from GEO (shop) {%- endcomment -%}
{%- assign tf_geo_shop_val = shop.metafields.tripleform_cod.geo.value -%}
{%- assign tf_ui_coupon = false -%}
{%- assign tf_ui_variants = false -%}

{%- if tf_geo_shop_val and tf_geo_shop_val != blank -%}
  {%- assign tf_geo = tf_geo_shop_val -%}
  {%- if tf_geo.ui != blank -%}
    {%- if tf_geo.ui.enableCouponField == true -%}{%- assign tf_ui_coupon = true -%}{%- endif -%}
    {%- if tf_geo.ui.enableVariantSelector == true -%}{%- assign tf_ui_variants = true -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ✅ Theme Editor layout defaults {%- endcomment -%}
{%- assign tf_summary_position = section.settings.summary_position | default: 'top' -%}
{%- assign tf_summary_order = section.settings.summary_order | default: 3 -%}
{%- assign tf_offers_position = section.settings.offers_position | default: 'top' -%}
{%- assign tf_offers_order = section.settings.offers_order | default: 1 -%}
{%- assign tf_upsells_position = section.settings.upsells_position | default: 'top' -%}
{%- assign tf_upsells_order = section.settings.upsells_order | default: 2 -%}

{%- comment -%} ✅ Settings JSON (shop > default) {%- endcomment -%}
{%- if tf_shop_val and tf_shop_val != blank -%}
  {%- assign tf_json = tf_shop_val -%}
{%- else -%}
  {%- assign shop_country_code = shop.country_code | default: 'MA' -%}
  {%- capture tf_json -%}
  {
    "meta": { "version": 1, "preset": "CleanWhite" },
    "form": {
      "style": "inline",
      "title": "Order form",
      "subtitle": "Please enter your contact information",
      "buttonText": "Order now",
      "successText": "Thanks! We'll contact you",
      "buttonIcon": "CartIcon"
    },
    "thankyou": {
      "enabled": true,
      "mode": "popup",
      "title": "Thank you!",
      "text": "Your order has been received. We will contact you soon.",
      "primaryLabel": "Continue shopping",
      "primaryUrl": "/",
      "secondaryLabel": "Close",
      "secondaryAction": "close",
      "autoCloseMs": 0
    },
    "design": {
      "bg": "#FFFFFF",
      "text": "#0F172A",
      "border": "#E5E7EB",
      "radius": 12,
      "padding": 16,
      "inputBg": "#FFFFFF",
      "inputBorder": "#E5E7EB",
      "placeholder": "#94A3B8",
      "btnBg": "#111827",
      "btnText": "#FFFFFF",
      "btnBorder": "#111827",
      "btnHeight": 46,
      "btnRadius": 10,
      "shadow": true,
      "glow": false,
      "glowPx": 18,
      "cartBg": "#FFFFFF",
      "cartBorder": "#E5E7EB",
      "cartRowBg": "#FFFFFF",
      "cartRowBorder": "#E5E7EB",
      "cartTitleColor": "#0F172A",
      "cartTextColor": "#0F172A",
      "direction": "ltr",
      "fontSize": 14,
      "titleAlign": "left",
      "fieldAlign": "left"
    },
    "behavior": {
      "requireGDPR": false,
      "gdprLabel": "I accept the privacy policy",
      "whatsappOptIn": false,
      "whatsappLabel": "Receive confirmation on WhatsApp",
      "openDelayMs": 0,
      "closeOnOutside": true,
      "effect": "none",
      "buttonMotion": "none",
      "stickyType": "none",
      "stickyLabel": "Order now",
      "stickyIcon": "CartIcon",
      "drawerDirection": "right",
      "drawerSize": "md",
      "overlayColor": "#020617",
      "overlayOpacity": 70,
      "country": "{{ shop_country_code }}",
      "codCountry": "{{ shop_country_code }}",
      "provinceKey": "",
      "cityKey": ""
    },
    "fields": {
      "name": { "on": true, "required": true, "type": "text", "label": "Full name", "ph": "Your full name", "icon": "ProfileIcon" },
      "phone": { "on": true, "required": true, "type": "tel", "label": "Phone (WhatsApp)", "ph": "Phone number", "prefix": "+212", "icon": "PhoneIcon" },
      "quantity": { "on": true, "required": true, "type": "number", "label": "Quantity", "ph": "1", "min": 1, "max": 10, "icon": "HashtagIcon" },
      "province": { "on": true, "required": false, "type": "select", "label": "Province", "ph": "Select province", "icon": "RegionIcon" },
      "city": { "on": true, "required": false, "type": "select", "label": "City", "ph": "Select city", "icon": "CityIcon" },
      "address": { "on": false, "required": false, "type": "text", "label": "Address", "ph": "Full address", "icon": "LocationIcon" },
      "notes": { "on": false, "required": false, "type": "textarea", "label": "Notes", "ph": "(optional)", "icon": "NoteIcon" }
    },
    "cartTitles": {
      "top": "Order summary",
      "price": "Product price",
      "shipping": "Shipping price",
      "total": "Total",
      "shippingToCalculate": "Shipping to calculate",
      "cartIcon": "CartIcon"
    },
    "uiTitles": {
      "applyCoupon": "Apply",
      "orderNow": "Order now",
      "totalSuffix": "Total:"
    },
    "ui": {
      "enableCouponField": {{ tf_ui_coupon | json }},
      "enableVariantSelector": {{ tf_ui_variants | json }}
    }
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} ✅ OFFERS / UPSELL (shop > default) {%- endcomment -%}
{%- assign tf_offers_shop_val = shop.metafields.tripleform_cod.offers.value -%}

{%- if tf_offers_shop_val and tf_offers_shop_val != blank -%}
  {%- assign tf_offers_json = tf_offers_shop_val -%}
{%- else -%}
  {%- capture tf_offers_json -%}
  {
    "meta": { "version": 10 },
    "global": {
      "enabled": true,
      "currency": "{{ shop.currency | default: 'MAD' }}",
      "rounding": "none",
      "colorPalette": "blue-gradient"
    },
    "offers": [],
    "upsells": [],
    "display": {
      "showOrderSummary": true,
      "showOffersSection": true,
      "showTimerInPreview": true,
      "showActivationButtons": true
    }
  }
  {%- endcapture -%}
{%- endif -%}

<div
  id="tripleform-cod-{{ section.id }}"
  class="tripleform-cod"
  data-section-id="{{ section.id }}"

  {%- comment -%} ✅ OLD LOGIC encoding {%- endcomment -%}
  data-settings='{% if tf_shop_val and tf_shop_val != blank %}{{ tf_json | json | escape }}{% else %}{{ tf_json | strip | strip_newlines | escape }}{% endif %}'
  data-offers='{% if tf_offers_shop_val and tf_offers_shop_val != blank %}{{ tf_offers_json | json | escape }}{% else %}{{ tf_offers_json | strip | strip_newlines | escape }}{% endif %}'

  data-product-id=''
  data-variant-id=''
  data-currency='{{ cart.currency.iso_code | default: shop.currency }}'
  data-locale='{{ request.locale.iso_code }}'

  data-summary-position="{{ tf_summary_position }}"
  data-summary-order="{{ tf_summary_order }}"
  data-offers-position="{{ tf_offers_position }}"
  data-offers-order="{{ tf_offers_order }}"
  data-upsells-position="{{ tf_upsells_position }}"
  data-upsells-order="{{ tf_upsells_order }}"

  data-recaptcha-enabled="{% if tf_recaptcha_enabled %}true{% else %}false{% endif %}"
  data-recaptcha-version="v2"
  data-recaptcha-site-key="{{ tf_recaptcha_site_key | escape }}"
  data-recaptcha-v2-size="normal"
  data-recaptcha-v2-theme="light"
  data-recaptcha-v2-container="#tf-recaptcha-v2-{{ section.id }}"

  data-geo-enabled="true"
  data-geo-country="{{ shop.country_code | default: 'MA' }}"
  data-geo-endpoint="/apps/tripleform-cod/api/geo/calc"

  data-ui-coupon="{% if tf_ui_coupon %}true{% else %}false{% endif %}"
  data-ui-variants="{% if tf_ui_variants %}true{% else %}false{% endif %}"
  data-cart-mode="true"
>
  <noscript>Enable JavaScript to use the COD form.</noscript>

  <div style="font:14px/1.4 system-ui, sans-serif; color:#6b7280">
    Loading COD form…
  </div>

  {%- if tf_recaptcha_enabled -%}
    <div
      id="tf-recaptcha-v2-{{ section.id }}"
      class="tf-recaptcha-v2"
      style="margin-top:12px"
      aria-label="reCAPTCHA"
    ></div>
  {%- endif -%}
</div>

<script type="application/json" id="tf-cart-json-{{ section.id }}">
  {{ cart | json }}
</script>

<script>
  (function () {
    function boot() {
      if (window.TripleformCOD && typeof window.TripleformCOD.boot === 'function') {
        window.TripleformCOD.boot('{{ section.id }}');
      }
    }
    document.addEventListener('DOMContentLoaded', boot);
    document.addEventListener('shopify:section:load', boot);
    document.addEventListener('shopify:section:select', boot);
    document.addEventListener('shopify:block:select', boot);
  })();
</script>

{% schema %}
{
  "name": "Tripleform COD (Cart)",
  "target": "section",
  "enabled_on": { "templates": ["cart"] },
  "stylesheet": "tripleform-cod.css",
  "javascript": "tripleform.js",
  "settings": [
    {
      "type": "header",
      "content": "Blocks layout (Offers / Upsells / Summary)"
    },
    {
      "type": "select",
      "id": "offers_position",
      "label": "Offers position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "offers_order", "label": "Offers order", "min": 1, "max": 3, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "upsells_position",
      "label": "Upsells position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "upsells_order", "label": "Upsells order", "min": 1, "max": 3, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "summary_position",
      "label": "Order summary position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top (above form)" },
        { "value": "inside", "label": "Inside form (before button)" },
        { "value": "bottom", "label": "Bottom (below form)" },
        { "value": "hide", "label": "Hidden" }
      ]
    },
    { "type": "range", "id": "summary_order", "label": "Order summary order", "min": 1, "max": 3, "step": 1, "default": 3 }
  ]
}
{% endschema %}
